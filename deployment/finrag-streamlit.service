[Unit]
Description=Financial RAG Streamlit Visual Analytics Dashboard
After=network.target finrag.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Financial-Rag
EnvironmentFile=/home/ubuntu/Financial-Rag/.env
ExecStart=/home/ubuntu/Financial-Rag/.venv/bin/streamlit run frontend/app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=finrag-streamlit

[Install]
WantedBy=multi-user.target
