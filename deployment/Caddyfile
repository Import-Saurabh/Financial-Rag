# ==============================================================================
# Caddyfile — Reverse Proxy with Automatic Let's Encrypt HTTPS
# Domain: financial-nifty-rag.duckdns.org
# ==============================================================================
# Caddy automatically provisions and renews TLS certificates from Let's Encrypt.
# Meta WhatsApp Cloud API strictly requires HTTPS on port 443 with valid SSL.

financial-nifty-rag.duckdns.org {
    # Encode all responses with gzip and zstd compression
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # WhatsApp Webhook & React API Server (FastAPI backend on port 5000)
    reverse_proxy 127.0.0.1:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check probe
        health_uri /health
        health_interval 30s
    }

    # Logging
    log {
        output file /var/log/caddy/financial_nifty_rag_access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
